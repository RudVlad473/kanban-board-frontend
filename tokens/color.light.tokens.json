{
    "color": {
        "bg": {
            "app": { "$type": "color", "$value": "{color.grey.100}", "$description": "App background (light theme)" },
            "surface": {
                "$type": "color",
                "$value": "{color.white}",
                "$description": "Auth card / sidebar / Dropdown / Modal surface (light theme)"
            },
            "primary": { "$type": "color", "$value": "{color.purple.500}", "$description": "Primary CTA background" },
            "primary-hover": {
                "$type": "color",
                "$value": "{color.purple.300}",
                "$description": "Primary CTA hover/active state"
            },
            "danger": {
                "$type": "color",
                "$value": "{color.red.500}",
                "$description": "Destructive button background"
            },
            "danger-hover": {
                "$type": "color",
                "$value": "{color.red.300}",
                "$description": "Destructive button hover state"
            }
        },
        "border": {
            "default": {
                "$type": "color",
                "$value": "{color.grey.200}",
                "$description": "Default borders/dividers (light theme)"
            },
            "danger": {
                "$type": "color",
                "$value": "{color.red.500}",
                "$description": "TextField/Checkbox/Dropdown error border (D-17)"
            }
        },
        "text": {
            "primary": {
                "$type": "color",
                "$value": "{color.grey.900}",
                "$description": "Primary body/heading text (light theme)"
            },
            "muted": {
                "$type": "color",
                "$value": "{color.grey.550}",
                "$description": "Placeholder/disabled/secondary text. Uses the darkened grey.550 (not grey.500) so real muted text content (e.g. Field.Description) meets WCAG AA 4.5:1 against the light-theme surface."
            },
            "danger": {
                "$type": "color",
                "$value": "{color.red.500}",
                "$description": "TextField/Checkbox/Dropdown error text (D-17)"
            },
            "on-primary": {
                "$type": "color",
                "$value": "{color.white}",
                "$description": "Text on top of an accent-filled surface"
            }
        },
        "ring": {
            "focus": {
                "$type": "color",
                "$value": "{color.purple.500}",
                "$description": "Focus-visible outline on all interactive primitives"
            }
        }
    }
}
