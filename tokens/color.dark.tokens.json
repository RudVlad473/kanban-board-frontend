            },
            "column-2": {
                "$type": "color",
                "$value": "{color.violet.400}",
                "$description": "Decorative column-header dot, board position 1 (U-03). Theme-identical, as column-1."
            },
            "column-3": {
                "$type": "color",
                "$value": "{color.mint.400}",
                "$description": "Decorative column-header dot, board position 2 (U-03). Theme-identical, as column-1."
            }
        },
        "bg": {
            "app": { "$type": "color", "$value": "{color.grey.800}", "$description": "App background (dark theme)" },
            "surface": {
                "$type": "color",
                "$value": "{color.grey.700}",
                "$description": "Auth card / sidebar / Dropdown / Modal surface (dark theme)"
            },
            "primary": { "$type": "color", "$value": "{color.purple.500}", "$description": "Primary CTA background" },
            "primary-hover": {
                "$type": "color",
                "$value": "{color.purple.300}",
                "$description": "Primary CTA hover/active state"
            },
            "danger": {
                "$type": "color",
                "$value": "{color.red.500}",
                "$description": "Destructive button background"
            },
            "danger-hover": {
                "$type": "color",
                "$value": "{color.red.300}",
                "$description": "Destructive button hover state"
            },
            "column-add-from": {
                "$type": "color",
                "$value": "{color.grey.750}",
