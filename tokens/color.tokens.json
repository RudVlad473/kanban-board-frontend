      "800": { "$type": "color", "$value": "#20212C", "$description": "App background (dark theme)" },
      "700": { "$type": "color", "$value": "#2B2C37", "$description": "Card/sidebar/Dropdown surface (dark theme)" },
      "600": { "$type": "color", "$value": "#3E3F4E", "$description": "Borders/dividers (dark theme)" },
      "500": {
        "$type": "color",
        "$value": "#828FA3",
        "$description": "Placeholder/disabled/secondary text (both themes)"
