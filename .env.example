# The external API's base URL, read by src/lib/api/server-client.ts. Never hardcoded in source
# (ADR tech/0006) — set per environment (local / Vercel Preview / Vercel Production).
#
# Local value below is the contract's declared server URL (docs/api/kanban-board-openapi.json's
# `servers[0].url`). No real backend is deployed yet, so this is intercepted by the MSW mock
# regardless of value — see src/lib/mocks/ and instrumentation.ts.
EXTERNAL_API_BASE_URL=http://localhost:8080/api

# Signs the session cookie (src/lib/session.ts). Generate locally with `openssl rand -base64 32`
# and place the result in .env.local — never commit a real value. Read with no fallback default:
# a missing SESSION_SECRET fails fast at module load (ADR tech/0001); a default secret would fail
# silently instead, which is worse.
SESSION_SECRET=
