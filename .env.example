# This project runs no mock server (docs/adr/tech/0018) — every layer, including local
# development, dials the deployed non-production backend directly. Set this to that backend's
# base URL, including its /api context path:
EXTERNAL_API_BASE_URL=https://kanban-board-rud-vlad-473-nonprod.duckdns.org/api

# Signs the session cookie (src/lib/session.ts). Generate locally with `openssl rand -base64 32`
# and place the result in .env.local — never commit a real value. Read with no fallback default:
# a missing SESSION_SECRET fails fast at module load (ADR tech/0001); a default secret would fail
# silently instead, which is worse.
SESSION_SECRET=
