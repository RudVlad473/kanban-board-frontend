{
    "name": "kanban-board-frontend",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky",
        "tokens:build": "node scripts/build-tokens.mjs",
        "prebuild": "pnpm tokens:build",
        "predev": "pnpm tokens:build",
        "test": "vitest run",
        "test:browser": "vitest run --project browser",
        "test:unit": "vitest run --project unit",
        "test:a11y": "vitest run --project storybook",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "test:visual": "playwright test",
        "test:all": "pnpm test && pnpm exec playwright test",
        "api:generate": "openapi-typescript docs/api/kanban-board-openapi.json -o src/lib/api/generated-types.ts"
    },
    "dependencies": {
        "@base-ui/react": "1.7.0",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "jose": "6.2.8",
        "lucide-react": "1.31.0",
        "next": "16.3.0",
        "openapi-fetch": "0.17.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "server-only": "0.0.1",
        "tailwind-merge": "3.6.0",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@playwright/test": "1.62.1",
        "@storybook/addon-a11y": "10.5.7",
        "@storybook/addon-vitest": "10.5.7",
        "@storybook/nextjs-vite": "10.5.7",
        "@stylistic/eslint-plugin": "5.10.0",
        "@tailwindcss/postcss": "4.3.3",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.2",
        "@testing-library/user-event": "14.6.3",
        "@types/node": "20.19.43",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@vitest/browser": "4.1.10",
        "@vitest/browser-playwright": "4.1.10",
        "eslint": "10.8.1",
        "eslint-config-next": "16.3.0",
        "eslint-import-resolver-typescript": "4.4.5",
        "eslint-plugin-boundaries": "7.2.0",
        "eslint-plugin-import-x": "4.17.1",
        "eslint-plugin-prefer-arrow-functions": "3.10.2",
        "eslint-plugin-tailwindcss": "4.2.0",
        "husky": "9.1.7",
        "jsdom": "30.0.1",
        "lint-staged": "17.3.0",
        "msw": "2.15.0",
        "openapi-typescript": "7.13.0",
        "prettier": "3.9.6",
        "prettier-plugin-tailwindcss": "0.8.1",
        "storybook": "10.5.7",
        "style-dictionary": "5.5.1",
        "tailwindcss": "4.3.3",
        "typescript": "6.0.3",
        "typescript-eslint": "8.66.0",
        "vitest": "4.1.10",
        "vitest-browser-react": "2.2.0"
    },
    "packageManager": "pnpm@11.20.0",
    "msw": {
        "workerDirectory": [
            "public"
        ]
    }
}
