{
    "name": "kanban-board-frontend",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "routes:check": "node scripts/check-routes.mjs",
        "handlers:check": "node scripts/check-no-route-handlers.mjs",
        "stories:check": "node scripts/check-no-play-functions.mjs",
        "comments:check": "node scripts/check-comment-length.mjs",
        "tsx:check": "node scripts/check-tsx-declarations.mjs",
        "renders:check": "node scripts/check-story-only-renders.mjs",
        "folders:check": "node scripts/check-component-folders.mjs",
        "actions:check": "node scripts/check-action-verbs.mjs",
        "coverage:check": "node scripts/check-coverage-pointers.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky",
        "tokens:build": "node scripts/build-tokens.mjs",
        "prebuild": "pnpm tokens:build",
        "predev": "pnpm tokens:build",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:browser": "vitest run --project browser",
        "test:unit": "vitest run --project unit",
        "test:a11y": "vitest run --project storybook",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "test:visual": "playwright test --project visual",
        "test:e2e": "playwright test --project e2e",
        "test:smoke": "playwright test --project smoke",
        "e2e:seed": "bash e2e/seed.sh",
        "e2e:cleanup": "bash e2e/seed.sh cleanup",
        "test:all": "pnpm test && pnpm exec playwright test",
        "api:generate": "openapi-typescript docs/api/kanban-board-openapi.json -o src/lib/core/api-contract/generated-types.ts",
        "smoke:check": "node scripts/check-smoke-coverage.mjs"
    },
    "dependencies": {
        "@base-ui/react": "1.7.0",
        "@dnd-kit/core": "6.3.1",
        "@dnd-kit/sortable": "10.0.0",
        "@dnd-kit/utilities": "3.2.2",
        "@hookform/resolvers": "5.7.1",
        "@tanstack/react-query": "5.101.4",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "es-toolkit": "1.52.0",
        "jose": "6.2.8",
        "lucide-react": "1.31.0",
        "next": "16.3.0",
        "openapi-fetch": "0.17.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-hook-form": "7.85.0",
        "server-only": "0.0.1",
        "tailwind-merge": "3.6.0",
        "usehooks-ts": "3.1.1",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@playwright/test": "1.62.1",
        "@storybook/addon-a11y": "10.5.7",
        "@storybook/addon-vitest": "10.5.7",
        "@storybook/nextjs-vite": "10.5.7",
        "@storybook/react": "10.5.7",
        "@stylistic/eslint-plugin": "5.10.0",
        "@tailwindcss/postcss": "4.3.3",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.2",
        "@testing-library/user-event": "14.6.3",
        "@types/node": "20.19.43",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@vitest/browser": "4.1.10",
        "@vitest/browser-playwright": "4.1.10",
        "@vitest/coverage-v8": "4.1.10",
        "eslint": "10.8.1",
        "eslint-config-next": "16.3.0",
        "eslint-import-resolver-typescript": "4.4.5",
        "eslint-plugin-boundaries": "7.2.0",
        "eslint-plugin-check-file": "^3.3.2",
        "eslint-plugin-import-x": "4.17.1",
        "eslint-plugin-no-unsanitized": "4.1.5",
        "eslint-plugin-prefer-arrow-functions": "3.10.2",
        "eslint-plugin-tailwindcss": "4.2.0",
        "husky": "9.1.7",
        "jsdom": "30.0.1",
        "lint-staged": "17.3.0",
        "openapi-typescript": "7.13.0",
        "prettier": "3.9.6",
        "prettier-plugin-tailwindcss": "0.8.1",
        "storybook": "10.5.7",
        "style-dictionary": "5.5.1",
        "tailwindcss": "4.3.3",
        "typescript": "6.0.3",
        "typescript-eslint": "8.66.0",
        "vercel": "59.1.4",
        "vitest": "4.1.10",
        "vitest-browser-react": "2.2.0"
    },
    "packageManager": "pnpm@11.20.0",
    "engines": {
        "node": "24.x"
    }
}
