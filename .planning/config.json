{
  "workflow": {
    "_auto_chain_active": false,
    "plan_check": true,
    "verifier": true,
    "research": true,
    "subagent_timeout": 900000,
    "build_command": "pnpm build",
    "test_command": "pnpm test",
    "test_gate_timeout": 900,
    "nyquist_validation": false,
    "discuss_mode": "assumptions",
    "pattern_mapper": false,
    "post_planning_gaps": false,
    "security_enforcement": false,
    "ui_phase": false,
    "auto_prune_state": true,
    "inline_plan_threshold": 3,
    "use_worktrees": false
  },
  "git": {
    "branching_strategy": "phase"
  },
  "context_window": 1000000,
  "graphify": {
    "build_timeout": 600
  },
  "agent_skills": {
    "gsd-executor": "global:lsp-first-navigation",
    "gsd-code-fixer": "global:lsp-first-navigation",
    "gsd-code-reviewer": "global:lsp-first-navigation",
    "gsd-debugger": "global:lsp-first-navigation",
    "gsd-verifier": "global:lsp-first-navigation"
  },
  "granularity": "coarse",
  "fast_mode": {
    "enabled": true
  },
  "model_profile": "balanced",
  "review": {
    "default_reviewers": [
      "agy"
    ],
    "models": {
      "agy": "gemini-3.1-pro-preview"
    }
  }
}
