# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
node_modules/
dist
dist-ssr
*.local

# Next.js build output
.next/
*.tsbuildinfo

# Environment variables
.env
.env*.local

# Local-only reference assets (not committed — large binaries / external specs)
.planning/local-assets/
# Figma design-mock export, 110MB+ — over GitHub's 100MB hard limit
docs/kanban-task-management-web-app.pdf

# Test/build artifacts (harness — plan 01-05)
test-results/
playwright-report/
.vitest-attachments/
.e2e-seeded-users/
coverage/
# Vitest Browser Mode's own failure screenshots, co-located next to the failing test file — not
# the committed Playwright visual-regression baselines under visual/__screenshots__ (Task 3).
# Covers both src/ (component tests) and app/ (route-boundary tests, plan 01-17) test locations.
src/**/__screenshots__/
app/**/__screenshots__/
storybook-static/

# GSD / harness runtime state (not meant to be committed)
.gsd/
.claude/worktrees/
.worktrees/
# Machine-local Claude Code state, never shared. Listed file-by-file rather than ignoring all of
# .claude/ so genuinely shared config (skills, agents) stays trackable if it is ever added.
.claude/settings.local.json
.claude/scheduled_tasks.lock
# GSD's per-session phase lock — holds a pid, meaningless on another machine.
.planning/milestone.lock

# Browser-automation MCP scratch output (console logs, screenshots)
.playwright-mcp/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.vercel

